# É sempre interessante manter um arquivo mostrando quais os nomes de variáveis e, se possível, o formato 
# que tem de ser passado para elas conforme você fez. Porém, nunca suba o .env em si. Suba um arquivo chamado .env.example

# Para casos assim, é interessante criar um arquivo .gitignore

# Outro ponto, não é comum subirmos a pasta node_modules. Em raros os casos vc vai acabar subindo as pastas com as dependências ou environment
# geralmente as empresas fazem isso quando tem restrições sobre uso de token para busca de libs privadas ou quando uma dependência já
# não é mais encontrada remotamente (isso em caso de alguém excluir o repositório, por exemplo)

MONGO_URL=mongodb://localhost:27017/notifications
PORT=3000


# PONTO DE ATENÇÃO: todas as alterações subiram dentro de uma mesmo commit com a mensagem "fist commit".
# Isso é bem perigoso de ser feito, um commit com tudo deixa dificil de encontrar mudanças que subiram e quebraram algo
# ou mesmo de compartilhar e entender o que foi feito. Digo, para entender o que foi feito eu teria que literalmente abrir e olhar o código inteiro
# enquanto se fosse separado em partes como abaixo deixariam bem mais claro e conciso

# feat: add Mongo Database Connector
# fix: remove process.Exit(1) killing application even when connected to mongo
# chore: increase number of running workers
# refact: organize task statuses into enums and constants for better readability

